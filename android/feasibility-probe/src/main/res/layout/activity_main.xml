<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="VĀṆI · M1 Offline Speech Link" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="M1 vertical slice: speech → editable transcript → semantic bundle → direct local link → ACK → speech. Physical offline proof remains a release gate." />
        <TextView android:id="@+id/offlineStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textStyle="bold" />
        <Button android:id="@+id/refreshOfflineButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Refresh network state" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="18dp" android:background="#33000000" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Receiver" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/localAddresses" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textIsSelectable="true" />
        <Button android:id="@+id/hostButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Start receiver on port 42424" />
        <TextView android:id="@+id/hostStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Receiver stopped" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="18dp" android:background="#33000000" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="M1 sender" android:textSize="18sp" android:textStyle="bold" />
        <EditText android:id="@+id/hostInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Receiver IPv4 address" android:inputType="textUri" android:maxLines="1" />
        <EditText android:id="@+id/payloadInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="top|start" android:inputType="textMultiLine" android:minLines="3" android:text="@string/default_payload" />
        <Button android:id="@+id/sendButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Send UTF-8 payload" />
        <TextView android:id="@+id/sendStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="No transfer yet" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="18dp" android:background="#33000000" />
        <TextView android:id="@+id/m1State" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="M1 state: IDLE" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/transcriptText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Transcript: —" android:textIsSelectable="true" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="18dp" android:background="#33000000" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Speech feasibility" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/speechStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <EditText android:id="@+id/speechLocale" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ASR locale" android:text="hi-IN" />
        <Button android:id="@+id/asrButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Hold-to-speak / run ASR" />
        <EditText android:id="@+id/ttsLocale" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="TTS locale" android:text="hi-IN" />
        <EditText android:id="@+id/ttsText" android:layout_width="match_parent" android:layout_height="wrap_content" android:minLines="2" android:inputType="textMultiLine" android:text="नमस्ते, यह ऑफ़लाइन वाणी परीक्षण है।" />
        <Button android:id="@+id/ttsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Synthesize + play" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="18dp" android:background="#33000000" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Evidence" android:textSize="18sp" android:textStyle="bold" />
        <Button android:id="@+id/copyEvidenceButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:enabled="false" android:text="Copy evidence JSON" />
        <TextView android:id="@+id/evidenceText" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:text="No experiment record yet." android:textIsSelectable="true" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
